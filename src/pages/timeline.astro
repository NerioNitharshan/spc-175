---
import "@fontsource/space-mono/700.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/space-grotesk/400.css";
import TIMELINE_EVENTS from "@config/timeline-events";

const groupedEvents = TIMELINE_EVENTS.reduce((acc, event) => {
    const eventDate = new Date(event.date);
    
    // Check for valid date
    if (isNaN(eventDate.getTime())) {
        console.warn(`Invalid date for event: ${JSON.stringify(event)}`);
        return acc; // Skip invalid dates
    }

    const monthYear = eventDate.toLocaleString('en-US', { month: 'long', year: 'numeric' });
    if (!acc[monthYear]) {
        acc[monthYear] = [];
    }
    acc[monthYear].push(event);
    return acc;
}, {});

function formatEventDate(date: string) {
    const eventDate = new Date(date);
    
    // Check for valid date
    if (isNaN(eventDate.getTime())) {
        return { month: 'N/A', day: 'N/A', year: 'N/A' }; // Fallback for invalid date
    }
    
    return {
        month: eventDate.toLocaleString('en-US', { month: 'short' }).toUpperCase(),
        day: eventDate.getDate(),
        year: eventDate.getFullYear()
    };
}
---

<main class="relative overflow-hidden bg-spc-dark py-12 sm:py-16 md:py-20 lg:py-24">
    <div class="absolute inset-0 opacity-10"></div>
    <div class="container mx-auto px-4 relative z-10">
        <div class="text-center mb-12">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-spc-light/90 mb-2">Upcoming</h2>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-mono font-bold text-spc-gold mb-2">
                Events
            </h1>
            <p class="mt-4 text-base sm:text-lg text-spc-light/70 max-w-lg mx-auto">
                "Join us in celebrating our rich heritage and bright future through these carefully curated events."
            </p>
        </div>

        <div id="event-container">
            {Object.entries(groupedEvents).length === 0 ? (
                <p class="text-center text-spc-light/70">No upcoming events available.</p>
            ) : (
                Object.entries(groupedEvents).map(([monthYear, events]) => (
                    <section class="mb-12" key={monthYear}>
                        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-spc-light/90 mb-6">{monthYear}</h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                            {events.map((event, index) => {
                                const { month, day, year } = formatEventDate(event.date);
                                return (
                                    <div class="bg-spc-dark/50 rounded-lg overflow-hidden shadow-lg fade-in-up event-card" key={index}>
                                        <div class="relative">
                                            <img alt="Event cover image" class="w-full h-64 object-cover" src={event.cover || '/path/to/default/image.png'} />
                                            <div class="absolute top-0 left-0 bg-spc-gold text-spc-dark p-2">
                                                <div class="text-3xl font-mono font-bold">{month}</div>
                                                <div class="text-5xl font-mono font-bold">{day}</div>
                                                <div class="text-xl font-mono">{year}</div>
                                            </div>
                                        </div>
                                        <div class="p-4">
                                            <h2 class="text-xl font-bold text-spc-light/90 mb-2">{event.title || 'Untitled Event'}</h2>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </section>
                ))
            )}
        </div>
    </div>
</main>

<style is:global>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .fade-in-up {
        animation: fadeInUp 0.5s ease-out forwards;
    }
    .event-card:hover {
        transform: translateY(-10px);
        transition: transform 0.3s ease;
    }
</style>
